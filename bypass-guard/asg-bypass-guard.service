[Unit]
Description=ASG Bypass Guard - Shadow AI data-plane bypass collector (IR-079 mode 3)
Documentation=https://internal/asg-bypass-guard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/wnt/ASG/asg-bypass-guard
ExecStart=/home/wnt/ASG/asg-bypass-guard/asg-bypass-guard -config /home/wnt/ASG/asg-bypass-guard/config.yaml
Restart=on-failure
RestartSec=3
# 生产环境默认关闭调试日志；排查时取消下行注释
# Environment=BYPASS_DEBUG=1
StandardOutput=append:/var/log/bypass-guard.log
StandardError=append:/var/log/bypass-guard.log
# AF_PACKET 抓包+注入需要 root（或 CAP_NET_RAW/CAP_NET_ADMIN）

[Install]
WantedBy=multi-user.target
